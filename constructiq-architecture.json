  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Runtime Flow",
      "items": [
        "1. Site Engineer submits daily workforce, material consumption, and geotagged proofs via Flutter App.",
        "2. Environmental gating (Open-Meteo) validates rainfall & temperature to lock hazardous concrete/plastering logs.",
        "3. Multi-tenant isolation enforced at Firestore Security Rules layer — companyId claim gates all document reads and writes. Role assignment enforced server-side via Cloud Function trigger — clients cannot write role or companyId fields directly.",
        "4. Firestore immutable document triggers FastAPI intelligence pipeline to compute Z-score material deviations and XGBoost cost overrun probabilities."
      ]
    },
    {
      "dot": "emerald",
      "title": "CAD-to-Estimate QTO & AI Assistant",
      "items": [
        "Architect uploads .DXF CAD directly to FastAPI with Firebase ID Bearer token -> ezdxf geometry extraction calculates CPWD standard quantities (cement, steel, bricks, labour-days).",
        "RAG Assistant embeds project logs and estimates in ChromaDB using all-MiniLM-L6-v2, queried with Llama-3.1-8B on NVIDIA NIM (<500ms)."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security",
      "items": [
        "Client Boundary: GPS geofencing and offline queue prevent off-site falsification directly on device.",
        "Identity Boundary: Firebase Auth custom claims set exclusively by Cloud Function — clients cannot self-assign roles.",
        "Microservice Boundary: Python backend validates Bearer ID tokens before parsing CAD files or evaluating deviations."
      ]
    },
    {
      "dot": "amber",
      "title": "ML Operations Layer",
      "items": [
        "XGBoost cost overrun classifier trained on project log features — tracked via MLflow with full param and metric history.",
        "Model registry promotes best-performing version to production inference endpoint.",
        "Target: retrain on real accumulated project data as app usage grows beyond synthetic training set."
      ]
    }
  ]
