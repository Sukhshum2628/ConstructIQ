rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    // Read companyId from custom claims (set by Cloud Function)
    // NOT from Firestore document read — avoids extra read cost
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == "admin";
    }

    function isManagerOrAbove() {
      return isAuth() && getUserRole() in ["admin", "manager"];
    }

    function belongsToCompany(companyId) {
      return isAuth() && getUserCompanyId() == companyId;
    }

    // Fields that only Cloud Functions may write
    // Clients can NEVER write role or companyId directly
    function isNotWritingProtectedFields() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["role", "companyId", "registrationStatus"]);
    }

    match /companies/{companyId} {
      allow read: if belongsToCompany(companyId);
      // Only allow company creation with correct creator field
      // Role assignment happens via Cloud Function trigger, not here
      allow create: if isAuth()
        && request.resource.data.createdBy == currentUserId();
      allow update: if isAdmin() && getUserCompanyId() == companyId;
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      // Unauthenticated read for signup validation
      allow read: if true;
      // Code creation now handled by Cloud Function only
      // Clients cannot create invite codes directly
      allow create: if false;
      // Admins can deactivate codes but not change core fields
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(["isActive"]);
      allow delete: if isAdmin()
        && resource.data.companyId == getUserCompanyId();
    }

    match /users/{uid} {
      allow read: if isAuth() && (currentUserId() == uid || (resource.data.companyId != null && belongsToCompany(resource.data.companyId)));

      // Allow user to create their own document with pending fields
      // Cloud Function will validate and replace with real role/companyId
      allow create: if isAuth()
        && currentUserId() == uid
        // Client can set pendingInviteCode or pendingCompanyId
        // but NOT role or companyId directly
        && !request.resource.data.keys().hasAny(["role", "companyId"]);

      // After creation, user can update profile fields only
      // role, companyId, registrationStatus are Cloud Function territory
      allow update: if isAuth()
        && currentUserId() == uid
        && isNotWritingProtectedFields();
    }

    match /projects/{projectId} {
      allow read: if belongsToCompany(resource.data.companyId);
      allow create: if isManagerOrAbove()
        && request.resource.data.companyId == getUserCompanyId();
      allow update: if belongsToCompany(resource.data.companyId)
        && isManagerOrAbove();
      allow delete: if isAdmin()
        && resource.data.companyId == getUserCompanyId();

      match /{subCollection}/{docId} {
        allow read, write: if belongsToCompany(
          get(/databases/$(database)/documents/projects/$(projectId))
            .data.companyId
        );
      }
    }

    match /workforce/{workerId} {
      allow read: if belongsToCompany(resource.data.companyId);
      allow create: if isManagerOrAbove()
        && request.resource.data.companyId == getUserCompanyId();
      allow update: if belongsToCompany(resource.data.companyId)
        && isManagerOrAbove();
      allow delete: if isAdmin()
        && resource.data.companyId == getUserCompanyId();
    }

    // Collection Group Queries for Projects
    match /{path=**}/deviations/{id} {
      allow read: if isAuth();
    }

    match /{path=**}/resourceLogs/{id} {
      allow read: if isAuth();
    }

    match /{path=**}/vendorBills/{id} {
      allow read: if isAuth();
    }

    match /{path=**}/delayNotices/{id} {
      allow read: if isAuth();
    }

    match /{path=**}/estimates/{id} {
      allow read: if isAuth();
    }

    match /{path=**}/delays/{id} {
      allow read: if isAuth();
    }
  }
}
